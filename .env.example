# Required: free key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional
GROQ_MODEL=openai/gpt-oss-120b
# Set this on public deployments so strangers cannot spend your Groq quota.
ANVIKSHA_ACCESS_KEY=
ANVIKSHA_PAPERS=5
ANVIKSHA_MAX_ATTEMPTS=3
ANVIKSHA_THRESHOLD=0.8

# Models used in "Auto" mode, per kind of task (see app/config.py).
ANVIKSHA_MODEL_FAST=openai/gpt-oss-20b
ANVIKSHA_MODEL_REASONING=openai/gpt-oss-120b
ANVIKSHA_MODEL_WRITING=openai/gpt-oss-120b
